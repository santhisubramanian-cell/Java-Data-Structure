class Node{
    int data;
    Node next;
    Node(int data){
        this.data=data;
        this.next=null;
    }
}
public class DeleteIndexvalLL {

    Node head = null;
    void insert(int data){
        Node newnode = new Node(data);
        newnode.next=head;
        head=newnode;
    }
    void display(){
        Node temp=head;
        while(temp!=null){
            System.out.print(temp.data+" ");
            temp=temp.next;
        }
        System.out.println();
    }

    void delete(int index){
        if(head==null){
            return;
        }
        if(index==0){
            head=head.next;
            return;
        }
        Node temp=head;
        for(int i=0;i<index-1 && temp!=null;i++){
            temp=temp.next;
        }
        temp.next=temp.next.next;

    }
    void display1(){
        Node temp = head;
        while(temp!=null){
            System.out.print(temp.data+"--->");
            temp=temp.next;
        }
        System.out.print("null");
    }

    public static void main(String[] args) {
        DeleteIndexvalLL ob = new DeleteIndexvalLL();
        ob.insert(1);
        ob.insert(2);
        ob.insert(3);
        ob.insert(4);
        ob.insert(5);
        ob.display();
        ob.delete(1);
        ob.display1();
    }
}
